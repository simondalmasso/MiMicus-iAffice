{
  "name": "aria-core",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-08-19",
  "workers_dev": true,
  "assets": { "directory": "./apps/cockpit", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [ { "binding": "DB", "database_name": "ariaos-v1", "database_id": "__D1_DATABASE_ID__", "migrations_dir": "migrations" } ],
  "services": [ { "binding": "EFFECTS", "service": "aria-effects" }, { "binding": "MODELS", "service": "aria-models" } ],
  "durable_objects": { "bindings": [{ "name": "COORDINATOR", "class_name": "AriaCoordinator" }, { "name": "COMPUTE_GOVERNOR", "class_name": "ComputeGovernorDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AriaCoordinator"] }, { "tag": "v2", "new_sqlite_classes": ["ComputeGovernorDO"] }],
  "vars": { "ENVIRONMENT": "production", "ARIA_GIT_SHA": "__ARIA_GIT_SHA__" }
}
